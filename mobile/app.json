{
  "expo": {
    "name": "AIFDMS Hostel App",
    "slug": "hms-mobile",
    "version": "2.1.0",
    "orientation": "portrait",
    "scheme": "hmsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "test.hms.mobile"
    },
    "android": {
      "package": "test.hms.mobile",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "AIFDMS Hostel App",
      "shortName": "AIFDMS",
      "themeColor": "#4f46e5",
      "backgroundColor": "#ffffff",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4f46e5",
          "sounds": [
            "./assets/meal_ready.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AIFDMS to access your photos to upload documents (Aadhaar, course proof, profile photo).",
          "cameraPermission": "Allow AIFDMS to access your camera to capture photos for upload."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AIFDMS to save chat images to your gallery.",
          "savePhotosPermission": "Allow AIFDMS to save chat images to your gallery."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://hms-api-47qf.onrender.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "3be841c1-c93d-4c54-b1fd-90e9e77ebe9b"
      }
    },
    "owner": "dhruvharani",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3be841c1-c93d-4c54-b1fd-90e9e77ebe9b"
    }
  }
}
