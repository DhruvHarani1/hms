// Hostel Management System — MVP schema (v1)
// Only the tables needed for the fast MVP are included here.
// Deferred features (rooms, leave, fees, visitors, etc.) are added later
// as additive migrations — see HOSTEL_MANAGEMENT_SYSTEM_DESIGN.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  super_admin
  warden
  staff
  student
  cook
}

enum UserStatus {
  pending
  active
  rejected
  inactive
  suspended
}

enum MealType {
  breakfast
  lunch
  dinner
  day
}

enum MealAttendanceStatus {
  present
  absent
  opted_out
}

enum MealSource {
  self
  qr
  staff
}

enum NotificationType {
  meal
  announcement
  emergency
  maintenance
  event
  individual
  complaint
}

enum NotificationAudience {
  all
  individual
}

enum NotificationPriority {
  low
  normal
  high
  critical
}

enum DevicePlatform {
  web
  android
  ios
}

enum ComplaintStatus {
  pending
  in_progress
  resolved
  closed
}

enum ComplaintPriority {
  low
  medium
  high
  urgent
}

enum NoticeCategory {
  announcement
  event
  holiday
  rules
  exam
}

enum ConversationType {
  direct
  group
}

enum MessageType {
  text
  image
}

// ─────────────────────────── Core / Auth ───────────────────────────

model Hostel {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  address      String?
  city         String?
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  logoUrl      String?  @map("logo_url")
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users                User[]
  notifications        Notification[]
  mealSessions         MealSession[]
  mealAttendances      MealAttendance[]
  complaints           Complaint[]
  complaintCategories  ComplaintCategory[]
  notices              Notice[]
  auditLogs            AuditLog[]
  attendances          Attendance[]
  leaves               LeaveRequest[]
  dishes               Dish[]
  conversations        Conversation[]

  @@map("hostels")
}

model User {
  id            String     @id @default(uuid())
  hostelId      String     @map("hostel_id")
  role          Role       @default(student)
  fullName      String     @map("full_name")
  email         String     @unique
  phone         String?
  passwordHash  String     @map("password_hash")
  avatarUrl     String?    @map("avatar_url")
  status          UserStatus @default(active)
  rejectionReason String?    @map("rejection_reason")
  emailVerified   DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  hostel                 Hostel                   @relation(fields: [hostelId], references: [id])
  studentProfile         StudentProfile?
  refreshTokens          RefreshToken[]
  passwordResets         PasswordReset[]
  deviceTokens           DeviceToken[]
  webPushSubscriptions   WebPushSubscription[]
  usageDaily             UsageDaily[]
  notificationRecipients NotificationRecipient[]
  mealAttendances        MealAttendance[]
  attendances            Attendance[]
  leaves                 LeaveRequest[]
  complaints             Complaint[]
  complaintReplies       ComplaintReply[]
  assignedComplaints     Complaint[]              @relation("ComplaintAssignee")
  createdConversations   Conversation[]           @relation("ConversationCreator")
  conversationMembers    ConversationMember[]
  sentMessages           Message[]                @relation("MessageSender")

  @@index([hostelId])
  @@map("users")
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  hostelId         String    @map("hostel_id")
  rollNo           String?   @map("roll_no")
  fatherName       String?   @map("father_name")
  surname          String?
  course           String?
  year             Int?
  department       String?
  instituteName    String?   @map("institute_name")
  instituteAddress String?   @map("institute_address")
  guardianName     String?   @map("guardian_name")
  guardianPhone    String?   @map("guardian_phone")
  bloodGroup       String?   @map("blood_group")
  emergencyContact String?   @map("emergency_contact")
  address          String?
  dob              DateTime?
  gender           String?
  photoUrl         String?   @map("photo_url")
  photoKey         String?   @map("photo_key")          // R2 object key: profile photo
  aadhaarKey       String?   @map("aadhaar_key")        // R2 object key: Aadhaar card
  courseProofKey   String?   @map("course_proof_key")   // R2 object key: fee receipt / course proof
  admissionDate    DateTime? @map("admission_date")
  hostelIdCardNo   String?   @map("hostel_id_card_no")
  roomNumber       String?   @map("room_number") // simple text for MVP; real room mgmt is deferred
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hostelId])
  @@map("student_profiles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(uuid())
  hostelId   String?  @map("hostel_id")
  actorId    String?  @map("actor_user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  hostel Hostel? @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@map("audit_logs")
}

// ─────────────────────────── Notifications ───────────────────────────

model Notification {
  id        String               @id @default(uuid())
  hostelId  String               @map("hostel_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  priority  NotificationPriority @default(normal)
  audience  NotificationAudience @default(all)
  createdBy String?              @map("created_by")
  createdAt DateTime             @default(now()) @map("created_at")

  hostel     Hostel                  @relation(fields: [hostelId], references: [id])
  recipients NotificationRecipient[]

  @@index([hostelId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String    @map("notification_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_recipients")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  platform  DevicePlatform
  token     String         @unique
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Per-user per-day active-time accumulator (seconds). Client pings while the
// app is in the foreground; we increment. One row per user per day.
model UsageDaily {
  id        String   @id @default(uuid())
  hostelId  String   @map("hostel_id")
  userId    String   @map("user_id")
  date      DateTime @db.Date
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([hostelId, date])
  @@map("usage_daily")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

// ─────────────────────────── Meals ───────────────────────────

model MealSession {
  id            String    @id @default(uuid())
  hostelId      String    @map("hostel_id")
  date          DateTime  @db.Date
  mealType      MealType  @map("meal_type")
  readyMarkedAt DateTime? @map("ready_marked_at")
  markedBy      String?   @map("marked_by")
  menu          String?
  createdAt     DateTime  @default(now()) @map("created_at")

  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@unique([hostelId, date, mealType])
  @@index([hostelId])
  @@map("meal_sessions")
}

// Master dish list — a separate list per meal type (breakfast/lunch/dinner).
model Dish {
  id        String   @id @default(uuid())
  hostelId  String   @map("hostel_id")
  mealType  MealType @map("meal_type")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId, mealType])
  @@map("dishes")
}

model MealAttendance {
  id        String               @id @default(uuid())
  hostelId  String               @map("hostel_id")
  studentId String               @map("student_id")
  date      DateTime             @db.Date
  mealType  MealType             @map("meal_type")
  status    MealAttendanceStatus @default(present)
  markedAt  DateTime             @default(now()) @map("marked_at")
  source    MealSource           @default(self)

  hostel  Hostel @relation(fields: [hostelId], references: [id])
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, mealType])
  @@index([hostelId, date])
  @@map("meal_attendance")
}

// ─────────────────────────── Complaints ───────────────────────────

model ComplaintCategory {
  id              String            @id @default(uuid())
  hostelId        String            @map("hostel_id")
  name            String
  defaultPriority ComplaintPriority @default(medium) @map("default_priority")

  hostel     Hostel      @relation(fields: [hostelId], references: [id])
  complaints Complaint[]

  @@map("complaint_categories")
}

model Complaint {
  id          String            @id @default(uuid())
  hostelId    String            @map("hostel_id")
  studentId   String            @map("student_id")
  categoryId  String?           @map("category_id")
  title       String
  description String
  status      ComplaintStatus   @default(pending)
  priority    ComplaintPriority @default(medium)
  assignedTo  String?           @map("assigned_to")
  resolvedAt  DateTime?         @map("resolved_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  hostel      Hostel                 @relation(fields: [hostelId], references: [id])
  student     User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignee    User?                  @relation("ComplaintAssignee", fields: [assignedTo], references: [id])
  category    ComplaintCategory?     @relation(fields: [categoryId], references: [id])
  replies     ComplaintReply[]
  attachments ComplaintAttachment[]

  @@index([hostelId, status])
  @@index([studentId])
  @@map("complaints")
}

model ComplaintReply {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  authorId    String   @map("author_id")
  message     String
  isInternal  Boolean  @default(false) @map("is_internal")
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([complaintId])
  @@map("complaint_replies")
}

model ComplaintAttachment {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  fileUrl     String   @map("file_url")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_attachments")
}

// ─────────────────────────── Attendance ───────────────────────────
// Default is PRESENT. A row here means the student was ABSENT that day
// (either self-marked or auto-created by a leave). No row = present.

model Attendance {
  id        String   @id @default(uuid())
  hostelId  String   @map("hostel_id")
  studentId String   @map("student_id")
  date      DateTime @db.Date
  viaLeave  Boolean  @default(false) @map("via_leave")
  createdAt DateTime @default(now()) @map("created_at")

  hostel  Hostel @relation(fields: [hostelId], references: [id])
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([hostelId, date])
  @@map("attendance")
}

// ─────────────────────────── Leave ───────────────────────────

model LeaveRequest {
  id        String   @id @default(uuid())
  hostelId  String   @map("hostel_id")
  studentId String   @map("student_id")
  startDate DateTime @db.Date @map("start_date")
  endDate   DateTime @db.Date @map("end_date")
  reason    String
  status    String   @default("applied") // auto-applied; kept for future workflow
  createdAt DateTime @default(now()) @map("created_at")

  hostel  Hostel @relation(fields: [hostelId], references: [id])
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([hostelId])
  @@index([studentId])
  @@map("leave_requests")
}

// ─────────────────────────── Notices ───────────────────────────

model Notice {
  id          String         @id @default(uuid())
  hostelId    String         @map("hostel_id")
  title       String
  body        String
  category    NoticeCategory @default(announcement)
  pinned      Boolean        @default(false)
  publishedAt DateTime?      @map("published_at")
  expiresAt   DateTime?      @map("expires_at")
  createdBy   String?        @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@map("notices")
}

// ─────────────────────────── Chat ───────────────────────────

model Conversation {
  id        String           @id @default(uuid())
  hostelId  String           @map("hostel_id")
  type      ConversationType
  name      String?
  avatarUrl String?          @map("avatar_url")
  createdBy String           @map("created_by")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  hostel   Hostel               @relation(fields: [hostelId], references: [id])
  creator  User                 @relation("ConversationCreator", fields: [createdBy], references: [id])
  members  ConversationMember[]
  messages Message[]

  @@index([hostelId])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  type           MessageType @default(text)
  content        String
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_otps")
}
