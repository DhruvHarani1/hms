# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────
# Local: install Postgres and create a db named "hms"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms?schema=public"

# ── Auth / JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── App ────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (Expo dev, etc.)
CORS_ORIGINS="*"

# ── File storage (Cloudinary — free, no card) ──────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Web Push (VAPID — free, for iOS PWA + browser push) ─
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@aifdms.app"

# ── Email (SMTP — password reset codes). Gmail app password or Brevo ─
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AIFDMS Hostel <you@gmail.com>"
