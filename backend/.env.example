# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────
# Local: install Postgres and create a db named "hms"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms?schema=public"

# ── Auth / JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── App ────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (Expo dev, etc.)
CORS_ORIGINS="*"

# Developer-only usage analytics dashboard key (any long random string).
# View at: <API>/api/v1/usage/dev/dashboard?key=THIS_VALUE
DEV_ANALYTICS_KEY=""

# ── File storage (Cloudinary — free, no card) ──────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Web Push (VAPID — free, for iOS PWA + browser push) ─
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@aifdms.app"

# ── Email (Brevo HTTP API — password reset codes; port 443, no SMTP blocks) ─
BREVO_API_KEY=""
MAIL_FROM="you@gmail.com"
MAIL_FROM_NAME="AIFDMS Hostel"
