# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────
# Local: install Postgres and create a db named "hms"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hms?schema=public"

# ── Auth / JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── App ────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (Expo dev, etc.)
CORS_ORIGINS="*"
